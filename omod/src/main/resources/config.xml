<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.4">

	<!-- Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<package>${project.parent.groupId}.${project.parent.artifactId}</package>
	<author>OpenMRS</author>
	<description>
		${project.parent.description}
	</description>
	<require_version>1.9.3</require_version>
	<!-- / Module Properties -->

	<require_modules>
		<require_module version="${uicommonsVersion}">org.openmrs.module.uicommons</require_module>
		<require_module version="${emrapiVersion}">org.openmrs.module.emrapi</require_module>
		<require_module version="${appframeworkVersion}">org.openmrs.module.appframework</require_module>
		<require_module version="${appuiVersion}">org.openmrs.module.appui</require_module>
		<require_module version="${coreappsVersion}">org.openmrs.module.coreapps</require_module>
		<require_module version="${webservicesRestVersion}">org.openmrs.module.webservices.rest</require_module>
		<require_module version="${rwandaemrVersion}">org.openmrs.module.rwandaemr</require_module>
		<require_module version="${fhir2Version}">org.openmrs.module.fhir2</require_module>
		<require_module version="${registrationcoreVersion}">org.openmrs.module.registrationcore</require_module>
		<require_module version="${addresshierarchyVersion}">org.openmrs.module.addresshierarchy</require_module>
	</require_modules>

	<aware_of_modules>
		<aware_of_module version="${mohbillingVersion}">org.openmrs.module.mohbilling</aware_of_module>
	</aware_of_modules>

	<!-- Module Activator -->
	<activator>${project.parent.groupId}.${project.parent.artifactId}.TransferAppActivator</activator>

	<mappingFiles>

	</mappingFiles>

	<packagesWithMappedClasses>
		org.openmrs.module.transferapp.model
	</packagesWithMappedClasses>

	<!-- Internationalization -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<!-- /Internationalization -->

	<globalProperty>
		<property>transferapp.receivedTransferConceptUuid</property>
		<defaultValue>076b04e5-d62d-47da-83e2-0da6e7a119b4</defaultValue>
		<description>UUID of the Transfer Id observation concept (value_text = HIE transfer UUID). Used by the HIE transfer patient fragment and dashboard received-transfer counts</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.registrationEncounterTypeId</property>
		<defaultValue>5</defaultValue>
		<description>Encounter type id for registration encounters used by the HIE transfer patient fragment. Falls back to rwandaemr.hie.registration_encounter_type_id when blank</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceTypeConceptUuid</property>
		<defaultValue>8da67e73-776c-43f6-9758-79d1f6786db3</defaultValue>
		<description>UUID of the observation concept for patient insurance type (coded)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceNumberConceptUuid</property>
		<defaultValue>5775fd72-b120-40e1-84a4-a2554a781bb2</defaultValue>
		<description>UUID of the observation concept for patient insurance number (text)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceCBHI</property>
		<defaultValue>6738</defaultValue>
		<description>Comma-separated concept IDs (value_coded) mapped to CBHI on the transfer preview</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceRSSB</property>
		<defaultValue>6739</defaultValue>
		<description>Comma-separated concept IDs (value_coded) mapped to RSSB on the transfer preview</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceMMI</property>
		<defaultValue>6955</defaultValue>
		<description>Comma-separated concept IDs (value_coded) mapped to MMI on the transfer preview</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceOther</property>
		<description>Comma-separated concept IDs (value_coded) mapped to Other on the transfer preview</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.insuranceNone</property>
		<defaultValue>1107</defaultValue>
		<description>Comma-separated concept IDs (value_coded) mapped to None on the transfer preview</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.diagnosisConceptUuid</property>
		<defaultValue>2dce81f9-3874-4247-b441-6369ca0725c2,afb8006f-e7c4-45bd-82bd-16f6e4b4b51d,3cd94c66-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Comma-separated observation concept UUIDs used to resolve diagnosis from the active visit (Primary ICD, Secondary ICD, Coded Diagnosis)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.ClinicalPresentationConceptUuid</property>
		<defaultValue>3ce2b170-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID used to resolve clinical presentation (chief complaint) value_text from the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.heightConceptUuid</property>
		<defaultValue>3ce93cf2-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for height on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.weightConceptUuid</property>
		<defaultValue>3ce93b62-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for weight on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.temperatureConceptUuid</property>
		<defaultValue>3ce939d2-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for temperature on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.pulseConceptUuid</property>
		<defaultValue>3ce93824-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for pulse on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.bloodPressureConceptUuid</property>
		<defaultValue>3ce934fa-26fe-102b-80cb-0017a47871b2/3ce93694-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Systolic/diastolic observation concept UUIDs separated by / for blood pressure</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.oxygenSaturationConceptUuid</property>
		<defaultValue>3ce9401c-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for oxygen saturation on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.muacConceptUuid</property>
		<defaultValue>4326b04b-3158-417a-bb8d-ad022295b0f4</defaultValue>
		<description>Observation concept UUID for MUAC on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.respiratoryRateConceptUuid</property>
		<defaultValue>3ceb11f8-26fe-102b-80cb-0017a47871b2</defaultValue>
		<description>Observation concept UUID for respiratory rate on the active visit</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.hie.url</property>
		<defaultValue>http://197.243.24.138:5001</defaultValue>
		<description>Fallback HIE base URL for outbound transfer submission</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.hie.username</property>
		<defaultValue>MRS_TEST</defaultValue>
		<description>Fallback HIE username for outbound transfer submission</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.hie.password</property>
		<description>Fallback HIE password for outbound transfer submission</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.hie.validatePatientAddress</property>
		<defaultValue>false</defaultValue>
		<description>When true, require HIE patient addresses to match the configured Rwanda address hierarchy before registration</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.verify_base_url</property>
		<defaultValue>http://197.243.24.138:8081</defaultValue>
		<description>Base URL for transfer verification QR codes (eTransfer verify endpoint)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sendingFosaId</property>
		<defaultValue>0074</defaultValue>
		<description>4-digit FOSAID of the sending facility used as Encounter.hospitalization.origin.identifier.value when submitting transfers to HIE</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.production</property>
		<defaultValue>true</defaultValue>
		<description>When true, ambulance voucher billing requires the current facility to be the designated ambulance provider. Set to false for testing so any facility can create ambulance bills regardless of provider FOSA. Patient registration from HIE search always follows the Pending workflow (any new patient)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sendingFacilityName</property>
		<defaultValue></defaultValue>
		<description>Comma-separated facility name aliases for inbound destination matching and pending targetOrg queries (including older/alternate HIE names). Example: Munini DH, Munini District Hospital. When blank, falls back to outboundFacilityName then session location</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.outboundFacilityName</property>
		<defaultValue></defaultValue>
		<description>Normalized facility display name written on outbound HIE transfer payloads (sendingFacility). Required before clinicians can open the outbound transfer form. Use the canonical HIE name</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.enabled</property>
		<defaultValue>false</defaultValue>
		<description>When true, send patient SMS via InTouch after HIE successfully accepts an outbound transfer (same gateway as eTransfer)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.base_url</property>
		<defaultValue>https://www.intouchsms.co.rw:1402</defaultValue>
		<description>InTouch SMS gateway base URL</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.send_path</property>
		<defaultValue>/send</defaultValue>
		<description>InTouch SMS send path appended to the base URL</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.username</property>
		<defaultValue></defaultValue>
		<description>InTouch SMS gateway username (same credentials as eTransfer)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.password</property>
		<defaultValue></defaultValue>
		<description>InTouch SMS gateway password</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.sender_id</property>
		<defaultValue>eBuzima</defaultValue>
		<description>InTouch SMS sender id (from field)</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.coding</property>
		<defaultValue>0</defaultValue>
		<description>InTouch SMS coding parameter</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.dlr_level</property>
		<defaultValue>2</defaultValue>
		<description>InTouch SMS delivery-report level</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.dlr_url</property>
		<defaultValue></defaultValue>
		<description>Optional delivery-report callback URL for InTouch SMS</description>
	</globalProperty>

	<globalProperty>
		<property>transferapp.sms.intouch.log_outbound_message</property>
		<defaultValue>false</defaultValue>
		<description>When true, log outbound SMS content locally before sending</description>
	</globalProperty>

	<privilege>
		<name>App: transferapp.dashboard</name>
		<description>Able to access the transfer dashboard</description>
	</privilege>

	<privilege>
		<name>Task: transferapp.listTransfers</name>
		<description>List Transfer</description>
	</privilege>

	<privilege>
		<name>Task: transferapp.createTransfer</name>
		<description>Create Transfer</description>
	</privilege>

	<privilege>
		<name>Task: transferapp.listpending</name>
		<description>List pending inbound transfers from HIE</description>
	</privilege>

	<privilege>
		<name>View: transferapp.pasttransfers</name>
		<description>View past transfer visits by month</description>
	</privilege>

	<privilege>
		<name>Task: transferapp.feedback</name>
		<description>Provide referral feedback and counter-referral on inbound transfers</description>
	</privilege>

	<privilege>
		<name>Task: transferapp.configuration</name>
		<description>Configure transfer destinations and approvers</description>
	</privilege>

</module>
