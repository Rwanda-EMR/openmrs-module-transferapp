<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

    <changeSet id="transferapp-20250617-create-transfer-table" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="transfers"/>
            </not>
        </preConditions>
        <comment>Create transfers table for outbound referral records</comment>
        <createTable tableName="transfers">
            <column name="transfer_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="decision_to_transfer_at" type="datetime"/>
            <column name="calling_time" type="varchar(8)"/>
            <column name="receiving_facility_code" type="varchar(64)"/>
            <column name="receiving_service" type="varchar(255)"/>
            <column name="staff_contacted_name" type="varchar(255)"/>
            <column name="staff_contacted_phone" type="varchar(64)"/>
            <column name="reason_for_transfer" type="text"/>
            <column name="emr_id" type="varchar(64)"/>
            <column name="client_name" type="varchar(255)"/>
            <column name="client_telephone" type="varchar(64)"/>
            <column name="age_or_dob" type="varchar(64)"/>
            <column name="sex" type="varchar(20)"/>
            <column name="identifier_type" type="varchar(40)"/>
            <column name="identifier_value" type="varchar(64)"/>
            <column name="caregiver_name" type="varchar(255)"/>
            <column name="caregiver_telephone" type="varchar(64)"/>
            <column name="client_district" type="varchar(120)"/>
            <column name="sector" type="varchar(120)"/>
            <column name="cell" type="varchar(120)"/>
            <column name="village" type="varchar(120)"/>
            <column name="sending_facility" type="varchar(255)"/>
            <column name="referring_provider_name" type="varchar(255)"/>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="int"/>
            <column name="date_changed" type="datetime"/>
            <column name="voided" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by" type="int"/>
            <column name="date_voided" type="datetime"/>
            <column name="void_reason" type="varchar(255)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="transfers_patient_fk"
                                 baseTableName="transfers"
                                 baseColumnNames="patient_id"
                                 referencedTableName="patient"
                                 referencedColumnNames="patient_id"/>

        <addForeignKeyConstraint constraintName="transfers_creator_fk"
                                 baseTableName="transfers"
                                 baseColumnNames="creator"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <addForeignKeyConstraint constraintName="transfers_changed_by_fk"
                                 baseTableName="transfers"
                                 baseColumnNames="changed_by"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <addForeignKeyConstraint constraintName="transfers_voided_by_fk"
                                 baseTableName="transfers"
                                 baseColumnNames="voided_by"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <createIndex tableName="transfers" indexName="transfers_patient_idx">
            <column name="patient_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="transferapp-20250617-add-transfer-patient-snapshot-columns" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="transfers"/>
                <not>
                    <columnExists tableName="transfers" columnName="emr_id"/>
                </not>
            </and>
        </preConditions>
        <comment>Add patient snapshot columns for transfer preview</comment>
        <addColumn tableName="transfers">
            <column name="emr_id" type="varchar(64)"/>
            <column name="client_name" type="varchar(255)"/>
            <column name="client_telephone" type="varchar(64)"/>
            <column name="age_or_dob" type="varchar(64)"/>
            <column name="sex" type="varchar(20)"/>
            <column name="identifier_type" type="varchar(40)"/>
            <column name="identifier_value" type="varchar(64)"/>
            <column name="caregiver_name" type="varchar(255)"/>
            <column name="caregiver_telephone" type="varchar(64)"/>
            <column name="client_district" type="varchar(120)"/>
            <column name="sector" type="varchar(120)"/>
            <column name="cell" type="varchar(120)"/>
            <column name="village" type="varchar(120)"/>
            <column name="sending_facility" type="varchar(255)"/>
            <column name="referring_provider_name" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="transferapp-20250617-create-receiving-facilities-table" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="transfer_receiving_facilities"/>
            </not>
        </preConditions>
        <comment>Per-sending-facility list of receiving facilities for transfer referrals</comment>
        <createTable tableName="transfer_receiving_facilities">
            <column name="receiving_facility_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sending_location_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="facility_code" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="facility_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="int"/>
            <column name="date_changed" type="datetime"/>
            <column name="voided" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by" type="int"/>
            <column name="date_voided" type="datetime"/>
            <column name="void_reason" type="varchar(255)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="transfer_receiving_facilities_location_fk"
                                 baseTableName="transfer_receiving_facilities"
                                 baseColumnNames="sending_location_id"
                                 referencedTableName="location"
                                 referencedColumnNames="location_id"/>

        <addForeignKeyConstraint constraintName="transfer_receiving_facilities_creator_fk"
                                 baseTableName="transfer_receiving_facilities"
                                 baseColumnNames="creator"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <createIndex tableName="transfer_receiving_facilities" indexName="transfer_receiving_facilities_location_idx">
            <column name="sending_location_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="transferapp-20250617-create-receiving-services-table" author="MoH Team">
