            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM global_property WHERE property = 'transferapp.fr_token'
            </sqlCheck>
        </preConditions>
        <comment>X-Auth-Token for HIE facility registry integration</comment>
        <insert tableName="global_property">
            <column name="property" value="transferapp.fr_token"/>
            <column name="property_value" value=""/>
            <column name="description" value="X-Auth-Token used when calling the HIE facility registry API"/>
            <column name="uuid" value="f3a8c2e1-4b5d-6e7f-8a9b-0c1d2e3f4a5b"/>
        </insert>
    </changeSet>

    <changeSet id="transferapp-20250705-received-from-hie-nullable-default" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="transfers"/>
                <columnExists tableName="transfers" columnName="received_from_hie"/>
            </and>
        </preConditions>
        <comment>Allow received_from_hie to be nullable with default false so outbound transfers can be created</comment>
        <sql>
            UPDATE transfers SET received_from_hie = 0 WHERE received_from_hie IS NULL;
            ALTER TABLE transfers MODIFY COLUMN received_from_hie TINYINT(1) NULL DEFAULT 0;
        </sql>
    </changeSet>

