    <changeSet id="transferapp-20260818-create-transfer-referral-feedback" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="transfer_referral_feedback"/>
            </not>
        </preConditions>
        <comment>
            Clinician referral feedback and counter-referral for an inbound HIE transfer.
            One non-voided row per HIE transfer UUID; hie_sent columns reserved for later HIE submit.
        </comment>
        <createTable tableName="transfer_referral_feedback">
            <column name="transfer_referral_feedback_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="patient_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="hie_transfer_id" type="varchar(64)">
                <constraints nullable="false"/>
