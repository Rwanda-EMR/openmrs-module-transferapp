        <addForeignKeyConstraint constraintName="transfer_receiving_services_location_fk"
                                 baseTableName="transfer_receiving_services"
                                 baseColumnNames="sending_location_id"
                                 referencedTableName="location"
                                 referencedColumnNames="location_id"/>

        <addForeignKeyConstraint constraintName="transfer_receiving_services_creator_fk"
                                 baseTableName="transfer_receiving_services"
                                 baseColumnNames="creator"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"/>

        <createIndex tableName="transfer_receiving_services" indexName="transfer_receiving_services_location_idx">
            <column name="sending_location_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="transferapp-20250622-receiving-services-by-facility" author="MoH Team">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="transfer_receiving_services"/>
                <columnExists tableName="transfer_receiving_services" columnName="sending_location_id"/>
                <not>
                    <columnExists tableName="transfer_receiving_services" columnName="receiving_facility_id"/>
                </not>
            </and>
        </preConditions>
        <comment>Link receiving services to receiving facilities instead of sending locations</comment>

        <dropForeignKeyConstraint baseTableName="transfer_receiving_services"
                                  constraintName="transfer_receiving_services_location_fk"/>
        <dropIndex tableName="transfer_receiving_services" indexName="transfer_receiving_services_location_idx"/>

        <sql>DELETE FROM transfer_receiving_services</sql>

        <dropColumn tableName="transfer_receiving_services" columnName="sending_location_id"/>

        <addColumn tableName="transfer_receiving_services">
            <column name="receiving_facility_id" type="int">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint constraintName="transfer_receiving_services_facility_fk"
                                 baseTableName="transfer_receiving_services"
                                 baseColumnNames="receiving_facility_id"
                                 referencedTableName="transfer_receiving_facilities"
                                 referencedColumnNames="receiving_facility_id"/>

        <createIndex tableName="transfer_receiving_services" indexName="transfer_receiving_services_facility_idx">
            <column name="receiving_facility_id"/>
        </createIndex>
    </changeSet>

